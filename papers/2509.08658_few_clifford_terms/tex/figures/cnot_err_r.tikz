\begin{tikzpicture}
    \begin{pgfonlayer}{nodelayer}
        \node [style=Z dot] (0) at (0.00, 1.00) {};
        \node [style=none] (1) at (2.00, 1.00) {};
        \node [style=none] (2) at (-2.00, 1.00) {};
        \node [style=X dot] (3) at (0.00, -1.00) {};
        \node [style=none] (4) at (-2.00, -1.00) {};
        \node [style=none] (5) at (2.00, -1.00) {};
        \node [style=X phase dot] (6) at (0.00, 0.00) {$\pi$};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw (0) to (2);
        \draw (0) to (1);
        \draw (0) to (6);
        \draw (3) to (4);
        \draw (3) to (5);
        \draw (3) to (6);
    \end{pgfonlayer}
\end{tikzpicture}