\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (-1.25, 1) {};
		\node [style=none] (1) at (-1.25, -1) {};
		\node [style=Z phase dot] (4) at (0, 0) {$\alpha$};
		\node [style=none] (6) at (1.25, 1) {};
		\node [style=none] (7) at (1.25, -1) {};
		\node [style=none] (8) at (1.25, 0.25) {$\vdots$};
		\node [style=none] (9) at (-1.25, 0.25) {$\vdots$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [bend left] (0.center) to (4);
		\draw [bend left] (4) to (6.center);
		\draw [bend right] (4) to (7.center);
		\draw [bend left] (4) to (1.center);
	\end{pgfonlayer}
\end{tikzpicture}
