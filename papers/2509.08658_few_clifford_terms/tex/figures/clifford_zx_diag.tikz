\begin{tikzpicture}
    \begin{pgfonlayer}{nodelayer}
        \node [style=Z dot] (0) at (0.50, 2.00) {};
        \node [style=Z dot] (1) at (3.25, 1.00) {};
        \node [style=Z phase dot] (2) at (2.50, -1.00) {$\pi$};
        \node [style=Z dot] (3) at (0.50, -0.50) {};
        \node [style=Z phase dot] (4) at (2.00, 2.00) {$\frac{\pi}{2}$};
        \node [style=none] (5) at (4.00, 2.00) {};
        \node [style=none] (6) at (4.00, 1.00) {};
        \node [style=none] (7) at (4.00, -0.00) {};
        \node [style=none] (8) at (4.00, -1.00) {};
        \node [style=none] (9) at (7.00, -1.00) {};
        \node [style=none] (10) at (7.00, -0.00) {};
        \node [style=none] (11) at (7.00, 2.00) {};
        \node [style=none] (12) at (7.00, 1.00) {};
        \node [style=none] (13) at (4.00, 2.50) {};
        \node [style=none] (14) at (7.00, -1.50) {};
        \node [style=none] (16) at (8.00, -1.00) {};
        \node [style=none] (17) at (8.00, -0.00) {};
        \node [style=none] (18) at (8.00, 1.00) {};
        \node [style=none] (dd) at (7.50, -.31) {\small$\vdots$};
        \node [style=none] (15) at (8.00, 2.00) {};
        \node [scale = 0.6] (19) at (5.50, 0.50) {$\begin{matrix}
            \text{Clifford} \\
            \text{ZX-diagram}
        \end{matrix}$};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw (13) rectangle (14);
        \draw [style=hadamard edge] (0) to (3);
        \draw [style=hadamard edge] (0) to (2);
        \draw (0) to (7);
        \draw [style=hadamard edge] (1) to (2);
        \draw [style=hadamard edge] (1) to (3);
        \draw (1) to (6);
        \draw (2) to (8);
        \draw [style=hadamard edge] (3) to (4);
        \draw (4) to (5);
        \draw (9) to (16);
        \draw (10) to (17);
        \draw (11) to (15);
        \draw (12) to (18);
    \end{pgfonlayer}
\end{tikzpicture}
