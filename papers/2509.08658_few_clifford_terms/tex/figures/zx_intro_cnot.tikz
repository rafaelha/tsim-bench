
\begin{tikzpicture}
    \begin{pgfonlayer}{nodelayer}
        \node [style=Z dot] (0) at (0, 0.50) {};
        \node [style=X dot] (1) at (0, -0.50) {};
        \node [style=none] (2) at (-1, 0.50) {};
        \node [style=none] (3) at (-1, -0.50) {};
        \node [style=none] (4) at (1, 0.50) {};
        \node [style=none] (5) at (1, -0.50) {};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw (2) to (0);
        \draw (4) to (0);
        \draw (3) to (1);
        \draw (5) to (1);
        \draw (0) to (1);
    \end{pgfonlayer}
\end{tikzpicture}
