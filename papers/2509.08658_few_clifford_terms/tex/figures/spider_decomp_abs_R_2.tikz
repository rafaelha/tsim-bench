\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (22) at (11.5, 1) {};
		\node [style=none] (23) at (11.5, -1) {};
		\node [style=X phase dot] (24) at (12.25, 0.5) {$\pi$};
		\node [style=none] (25) at (14, 1) {};
