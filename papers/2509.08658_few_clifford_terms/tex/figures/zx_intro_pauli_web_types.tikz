\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		% Closed Pauli web (detecting region)
		\node [style=none] (0) at (-11, 1) {};
		\node [style=none] (1) at (-11, -1) {};
		\node [style=Z dot] (2) at (-10, 1) {};
		\node [style=Z dot] (3) at (-10, -1) {};
		\node [style=Z dot] (4) at (-7.5, 1) {};
		\node [style=Z dot] (5) at (-7.5, -1) {};
		\node [style=X phase dot] (6) at (-8.75, 1) {$\pi$};
		\node [style=X phase dot] (7) at (-9.5, 0) {$k_1 \pi$};
		\node [style=X phase dot] (8) at (-7, 0) {$k_2 \pi$};
		\node [style=none] (9) at (-6.5, 1) {};
		\node [style=none] (10) at (-6.5, -1) {};
		\node [style=none, font=\scriptsize] (11) at (-8.75, -2) {Closed Pauli web};
		% Open Pauli web (stabilising)
		\node [style=none] (12) at (-2.5, 1) {};
		\node [style=none] (13) at (-2.5, -1) {};
		\node [style=Z dot] (14) at (-1.5, 1) {};
		\node [style=Z dot] (15) at (-1.5, -1) {};
		\node [style=X phase dot] (18) at (-0.25, 1) {$\pi$};
		\node [style=X phase dot] (19) at (-1, 0) {$k_1 \pi$};
		\node [style=none] (21) at (1, 1) {};
		\node [style=none] (22) at (1, -1) {};
		\node [style=none, font=\scriptsize] (23) at (-0.75, -2) {Open Pauli web};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		% Closed Pauli web edges
		\draw (0.center) to (2);
		\draw [style=Z Web] (2) to (6);
		\draw [style=Z Web] (6) to (4);
		\draw [style=Z Web] (4) to (8);
		\draw [style=Z Web] (5) to (8);
		\draw [style=Z Web] (5) to (3);
		\draw (3) to (1.center);
		\draw [style=Z Web] (3) to (7);
		\draw [style=Z Web] (7) to (2);
		\draw (10.center) to (5);
		\draw (4) to (9.center);
		% Open Pauli web edges
		\draw (12.center) to (14);
		\draw [style=Z Web] (14) to (18);
		\draw (15) to (13.center);
		\draw [style=Z Web] (15) to (19);
		\draw [style=Z Web] (19) to (14);
		\draw [style=Z Web] (18) to (21.center);
		\draw [style=Z Web] (22.center) to (15);
	\end{pgfonlayer}
\end{tikzpicture}
