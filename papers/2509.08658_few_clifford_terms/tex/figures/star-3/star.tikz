\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (0) at (0, 1) {};
		\node [style=none] (1) at (0, -1) {};
		\node [style=none] (3) at (0.75, 1) {};
		\node [style=none] (4) at (0.75, -1) {};
		\node [style=none] (5) at (1.5, 1) {};
		\node [style=none] (6) at (1.5, -1) {};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=star edge] (0.center) to (1.center);
		\draw [style=star edge] (3.center) to (4.center);
		\draw [style=star edge] (5.center) to (6.center);
	\end{pgfonlayer}
\end{tikzpicture}
