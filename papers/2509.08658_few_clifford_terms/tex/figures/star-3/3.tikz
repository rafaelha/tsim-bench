\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=Z dot] (0) at (0, 0.5) {};
		\node [style=Z dot] (1) at (0, -0.5) {};
		\node [style=none] (2) at (0, 1.25) {};
		\node [style=none] (3) at (0, -1.25) {};
		\node [style=none] (4) at (1.5, 1.25) {};
