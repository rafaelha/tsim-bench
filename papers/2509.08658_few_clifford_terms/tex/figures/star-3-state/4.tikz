\begin{tikzpicture}
	\begin{pgfonlayer}{nodelayer}
		\node [style=none] (1) at (1, -0.5) {};
		\node [style=none] (8) at (2, -0.5) {};
		\node [style=none] (11) at (0, -0.5) {};
		\node [style=Z phase dot] (12) at (0, 0.5) {$\pi$};
		\node [style=Z phase dot] (13) at (1, 0.5) {$\pi$};
		\node [style=Z phase dot] (14) at (2, 0.5) {$\pi$};
	\end{pgfonlayer}
	\begin{pgfonlayer}{edgelayer}
		\draw [style=hadamard edge] (11.center) to (12);
		\draw [style=hadamard edge] (13) to (1.center);
		\draw [style=hadamard edge] (8.center) to (14);
	\end{pgfonlayer}
\end{tikzpicture}
