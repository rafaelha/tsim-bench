
\begin{tikzpicture}
    \begin{pgfonlayer}{nodelayer}
        \node [style=Z phase dot] (1) at (2.00, -1.50) {$\frac{\pi}{4}$};
        \node [style=Z dot] (3) at (3.00, -0.00) {};
        \node [style=X dot] (4) at (3.00, -1.50) {};
        \node [style=X phase dot] (5) at (4.00, -1.50) {$a\pi$};
        \node [style=Z phase dot] (6) at (5.00, -0.00) {$a\frac{\pi}{2}$};
        \node [style=none] (7) at (1.00, -0.00) {};
        \node [style=none] (8) at (7.00, -0.00) {};
    \end{pgfonlayer}
    \begin{pgfonlayer}{edgelayer}
        \draw (1) to (4);
        \draw (3) to (4);
        \draw (3) to (6);
        \draw (3) to (7);
        \draw (4) to (5);
        \draw (6) to (8);
    \end{pgfonlayer}
\end{tikzpicture}
