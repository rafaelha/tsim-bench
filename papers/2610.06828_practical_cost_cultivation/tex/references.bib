@misc{hartweg_comparing_2026,
    title = {Comparing magic state cultivation methods using matrix product states},
    url = {http://arxiv.org/abs/2609.19116},
    doi = {10.48550/arXiv.2609.19116},
    abstract = {Magic state cultivation prepares high-fidelity magic states at low expected space-time costs; however, the exact performance of some schemes is unsettled due to the difficulty in simulating non-Clifford circuits. Here, we use matrix-product states (MPS) based methods to compute the exact performance of two types of fold-transversal cultivation schemes: (i) the Sahay et al method based on the regular surface code S gate, and (ii) a method we propose based on a partially fault-tolerant fold-transversal S gate. We show that for the former protocol at \$d=5\$, the \${\textbar}T{\textbackslash}rangle\$ output reaches similar logical error rates to the \${\textbar}S{\textbackslash}rangle\$ output, traditionally used as a cheap full Clifford proxy. This contrasts with the \${\textbackslash}sim10{\textbackslash}times\$ discrepancy reported for the \$d=5\$ colour-code scheme of Gidney et al. We also find that our new \$d=5\$ scheme has \${\textbackslash}sim1.3{\textbackslash}times\$ lower expected space-time cost while still reaching \$10{\textasciicircum}\{-9\}\$ logical error rate. We show that MPS and Clifford-augmented MPS (CAMPS) perform on par with or even better than the recently introduced near-Clifford simulator Clifft on the hardest \$d=5\$ regular surface code scheme. Additionally, to speed up simulation, we propose a new pre-screening method based on simple Pauli propagation, lowering by up to three orders of magnitude the required number of exact simulations, and use several simulator-agnostic sampling methods such as subset sampling.},
    urldate = {2026-09-17},
    publisher = {arXiv},
    author = {Hartweg, Tom and Orioli, Asier Piñeiro},
    month = sep,
    year = {2026},
    note = {arXiv:2609.19116 [quant-ph]},
    keywords = {Quantum Physics},
}
@misc{wan_exact_2026,
    title = {Exact logical error rates for magic state cultivation},
    url = {http://arxiv.org/abs/2609.18922},
    doi = {10.48550/arXiv.2609.18922},
    abstract = {We compute exactly the acceptance and logical error rates for the distance \$d=3\$ and \$d=5\$ magic state cultivation circuits from Clifft [arXiv:2604.27058] and SOFT [arXiv:2512.23037] using Pauli propagation and binary tensor contraction. Actual \$T\$ gates are studied, not the \$S\$-gate proxy used for sampling. The calculation includes every fault order at several circuit-level noise strengths (\$p\$). We provide a series expansion form to the logical error rates, through order \$(p/(1-p)){\textasciicircum}\{10\}\$. The analytical results recover the numerical values from Clifft and SOFT at both \$d=3\$ and \$d=5\$ to within their sampling uncertainty. Then, we show that the \$d=3\$ and \$d=5\$ circuits actually have fault distances of \$d\_\{{\textbackslash}text\{fault\}\}=2\$ and \$d\_\{{\textbackslash}text\{fault\}\}=3\$ respectively, explaining the similar distance degrading effects from the companion code of [Quantum 10, 2134 (2026)].},
    urldate = {2026-09-17},
    publisher = {arXiv},
    author = {Wan, Kwok Ho and Zapirain, Ainhoa},
    month = sep,
    year = {2026},
    note = {arXiv:2609.18922 [quant-ph]},
    keywords = {Quantum Physics},
}
@misc{chase_clifft_2026,
    title = {Clifft: {Fast} {Exact} {Simulation} of {Near}-{Clifford} {Quantum} {Circuits}},
    shorttitle = {Clifft},
    url = {http://arxiv.org/abs/2604.27058},
    doi = {10.48550/arXiv.2604.27058},
    abstract = {Exact classical simulation of fault-tolerant quantum circuits remains limited by a tradeoff between exponential state vector scaling, exponential \$T\$-count scaling in stabilizer-rank approaches, and per-shot tracking overhead in sparse generalized stabilizer simulators. In this work, we introduce Clifft, an open-source simulator that shifts the dominant exponential cost from the total qubit count to a dynamic active subspace by factoring the quantum state into an offline Clifford frame, an online Pauli frame, and a dynamically sized active state vector. This architecture resolves deterministic Clifford coordinate transformations ahead of time, generalizing Stim's compile-once, sample-many execution model to circuits with non-Clifford operations. Consequently, exponential simulation costs are determined by the peak active virtual dimension, which expands during non-Clifford operations and contracts during measurements. Clifft remains within a constant factor of standard tools in the pure-Clifford and non-Clifford limits, while delivering up to orders-of-magnitude throughput gains over GPU-accelerated near-Clifford simulators on low-magic fault-tolerant benchmarks. Executing on commodity CPUs and exposing a Stim-like API, Clifft enables, to our knowledge, the first exact end-to-end simulation of magic state cultivation including the escape stage, over hundreds of billions of shots. These simulations show that escape-stage failures suppress the discrepancy between the true \$T\$-gate circuit and its \$S\$-proxy at low decoder-gap thresholds, while at high thresholds the full-protocol behavior approaches the larger discrepancy observed in the cultivation stages alone.},
    urldate = {2026-09-17},
    publisher = {arXiv},
    author = {Chase, Bradley A. and Labib, Farrokh},
    month = may,
    year = {2026},
    note = {arXiv:2604.27058 [quant-ph]},
    keywords = {Quantum Physics},
}
@misc{chan_diagnosing_2026,
    title = {Diagnosing and {Restoring} the {Degraded} {Fault} {Distance} of {Magic} {State} {Cultivation}},
    url = {http://arxiv.org/abs/2609.17706},
    doi = {10.48550/arXiv.2609.17706},
    abstract = {T-state cultivation is a resource-efficient protocol producing logical T states but recent benchmarks show that its logical error rate is considerably higher than intended i.e. than S-state cultivation, which is the analogous protocol for producing logical S states. In this paper, we explain this T-S discrepancy by analytically showing, under circuit-level depolarising noise, that distance-3 (-5) T-state cultivation has fault distance 2 (3) due to Pauli hook errors that propagate to coherent Clifford errors after its final double-check circuit; such errors remain Pauli in S-state cultivation, which consequently retains fault distance 3 (5). As part of our analysis we derive a general formula, and an \${\textbackslash}mathcal O(n{\textasciicircum}3)\$-time algorithm for fixed logical-qubit count, for the acceptance probability of a logical mixed state afflicted with a Clifford error, where \$n\$ is the physical qubit count. We then design flags that detect the malignant hook errors in cultivation, improving the pre-escape logical error rate from \${\textbackslash}mathcal O(p{\textasciicircum}3)\$ to \${\textbackslash}mathcal O(p{\textasciicircum}5)\$. At noise level \$p =10{\textasciicircum}\{-3\}\$, this is a 4.9\${\textbackslash}times\$ improvement, costing a 1.36\${\textbackslash}times\$ increase in attempts per accepted shot.},
    urldate = {2026-09-17},
    publisher = {arXiv},
    author = {Chan, Tim and Strikis, Armands and Sun, Zhu and Cai, Zhenyu},
    month = sep,
    year = {2026},
    note = {arXiv:2609.17706 [quant-ph]},
    keywords = {Quantum Physics},
}

