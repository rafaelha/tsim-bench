\begin{tikzpicture}[font=\small]
\begin{yquant}[operator/separation=6mm,register/separation=5mm]
qubit {$\ket+$} a;
qubits {$\ket{\psi_L}$} d;
box {$D^\dagger$} d;
box {$X_{\rm all}$} d | a;
box {$D$} d;
