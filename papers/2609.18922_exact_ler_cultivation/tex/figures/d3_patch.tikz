\filldraw[fill=dthreeblue!48] (q0)--(q3)--(q7)--(q10)--cycle;
\filldraw[fill=dthreered!48] (q3)--(q9)--(q12)--(q7)--cycle;
\filldraw[fill=dthreegreen!48] (q7)--(q12)--(q13)--(q10)--cycle;
