\coordinate (heading) at ($(row6)+(0,8mm)$);
\node[anchor=south,font=\small] at (entry |- heading) {$D^\dagger$};
\node[anchor=south,font=\small] at (exit |- heading) {$D$};
\draw[black!60,decorate,decoration={brace,amplitude=2.5pt}] (g138n0 |- heading) -- (g150n0 |- heading) node[midway,above=3pt,font=\small] {fold};
\draw[black!60,decorate,decoration={brace,amplitude=2.5pt}] (g161n0 |- heading) -- (F2.east |- heading) node[midway,above=3pt,font=\small] {unfold};
