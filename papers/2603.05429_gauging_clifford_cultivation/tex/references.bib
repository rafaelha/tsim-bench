@misc{gidneyMagicStateCultivation2024,
  title = {Magic State Cultivation: Growing {{T}} States as Cheap as {{CNOT}} Gates},
  shorttitle = {Magic State Cultivation},
  author = {Gidney, Craig and Shutty, Noah and Jones, Cody},
  year = 2024,
  month = sep,
  number = {arXiv:2409.17595},
  eprint = {2409.17595},
  primaryclass = {quant-ph},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2409.17595},
  urldate = {2026-02-11},
  abstract = {We refine ideas from Knill 1996, Jones 2016, Chamberland 2020, Gidney 2023+2024, Bombin 2024, and Hirano 2024 to efficiently prepare good \$\textbar T\textbackslash rangle\$ states. We call our construction "magic state cultivation" because it gradually grows the size and reliability of one state. Cultivation fits inside a surface code patch and uses roughly the same number of physical gates as a lattice surgery CNOT gate of equivalent reliability. We estimate the infidelity of cultivation (from injection to idling at distance 15) using a mix of state vector simulation, stabilizer simulation, error enumeration, and Monte Carlo sampling. Compared to prior work, cultivation uses an order of magnitude fewer qubit-rounds to reach logical error rates as low as \$2 \textbackslash cdot 10\textasciicircum\textbraceleft -9\textbraceright\$ when subjected to \$10\textasciicircum\textbraceleft -3\textbraceright\$ uniform depolarizing circuit noise. Halving the circuit noise to \$5 \textbackslash cdot 10\textasciicircum\textbraceleft -4\textbraceright\$ improves the achievable logical error rate to \$4 \textbackslash cdot 10\textasciicircum\textbraceleft -11\textbraceright\$. Cultivation's efficiency and strong response to improvements in physical noise suggest that further magic state distillation may never be needed in practice.},
  archiveprefix = {arXiv},
  keywords = {Quantum Physics},
  file = {/Users/bencehetenyi/Zotero/storage/4N7NP4YT/Gidney et al. - 2024 - Magic state cultivation growing T states as cheap as CNOT gates.pdf;/Users/bencehetenyi/Zotero/storage/7ZLHDUP7/2409.html}
}


@misc{yoderTourGrossModular2025,
  title = {Tour de Gross: {{A}} Modular Quantum Computer Based on Bivariate Bicycle Codes},
  shorttitle = {Tour de Gross},
  author = {Yoder, Theodore J. and Schoute, Eddie and Rall, Patrick and Pritchett, Emily and Gambetta, Jay M. and Cross, Andrew W. and Carroll, Malcolm and Beverland, Michael E.},
  year = 2025,
  month = jun,
  number = {arXiv:2506.03094},
  eprint = {2506.03094},
  primaryclass = {quant-ph},
  publisher = {arXiv},
  doi = {10.48550/arXiv.2506.03094},
  urldate = {2026-02-11},
  abstract = {We present the bicycle architecture, a modular quantum computing framework based on high-rate, low-overhead quantum LDPC codes identified in prior work. For two specific bivariate bicycle codes with distances 12 and 18, we construct explicit fault-tolerant logical instruction sets and estimate the logical error rate of the instructions under circuit noise. We develop a compilation strategy adapted to the constraints of the bicycle architecture, enabling large-scale universal quantum circuit execution. Integrating these components, we perform end-to-end resource estimates demonstrating that an order of magnitude larger logical circuits can be implemented with a given number of physical qubits on the bicycle architecture than on surface code architectures. We anticipate further improvements through advances in code constructions, circuit designs, and compilation techniques.},
  archiveprefix = {arXiv},
  keywords = {Quantum Physics},
  file = {/Users/bencehetenyi/Zotero/storage/6LG4ENMK/Yoder et al. - 2025 - Tour de gross A modular quantum computer based on bivariate bicycle codes.pdf;/Users/bencehetenyi/Zotero/storage/WKDIGIQM/2506.html}
}

