@misc{williamsonDynamicalQuantumCodes2025,
  title = {Dynamical Quantum Codes and Logic Gates on a Lattice with Sparse Connectivity},
  author = {Williamson, Dominic J. and Het{\'e}nyi, Bence},
  year = 2025,
