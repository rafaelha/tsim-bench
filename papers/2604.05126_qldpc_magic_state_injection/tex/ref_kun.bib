@article{dong_experimental_2024,
	title = {Experimental quantum teleportation of a {Toffoli} gate across three spatially distributed parties in a photonic quantum network},
	volume = {32},
	copyright = {© 2024 Optica Publishing Group},
	issn = {1094-4087},
	url = {https://opg.optica.org/oe/abstract.cfm?uri=oe-32-22-39675},
	doi = {10.1364/OE.537668},
	abstract = {Quantum computers may offer significant computational advantages over classical counterparts, revolutionizing the technology landscape in the near future. When networked together, the advantage of quantum computing may be further amplified, and there may emerge innovative applications. Among various active explorations on distributed quantum computing, multiqubit quantum gates between distant networked quantum computers are of particular interest because they offer operational advantages of efficiency and fidelity. Here we report the first experimental demonstration of quantum teleportation for a Toffoli gate, which is a commonly used multiqubit quantum gate, across three spatially distributed parties within a photonic quantum network. Employing the Hofmann method, we estimate the fidelity of the teleported Toffoli gate to be at least 0.706 ± 0.131. This successful demonstration of the quantum teleportation of a Toffoli gate constitutes a critical step toward the ultimate realization of distributed quantum computation.},
	language = {EN},
	number = {22},
	urldate = {2025-01-31},
	journal = {Optics Express},
	publisher = {Optica Publishing Group},
	author = {Dong, Xiduo and Liu, Shiting and Mao, Ya-Li and Guo, Bixiang and Xu, Shufeng and Chen, Hu and Guo, Yuxiang and Li, Zheng-Da and Fan, Jingyun},
	month = oct,
	year = {2024},
	keywords = {Photonic entanglement, Quantum communications, Quantum computation, Quantum information, Quantum technology, Quantum teleportation},
	pages = {39675--39684},
}

@article{sarvaghad-moghaddam_general_2021,
	title = {A general protocol for distributed quantum gates},
	volume = {20},
	issn = {1573-1332},
	url = {https://doi.org/10.1007/s11128-021-03191-0},
	doi = {10.1007/s11128-021-03191-0},
	abstract = {In distributed quantum computation, quantum remote-controlled gates are used frequently and applied on separate nodes or subsystems of a network. One of the universal and well-known controlled gates is the n-qubit controlled-NOT gate, especially Toffoli gate for the case of three qubits, which are frequently used to synthesize quantum circuits. In this paper, we considered a more general case, an n-qubit controlled-U gate, and present a general protocol for implementing these gates remotely with minimum required resources. Then, the proposed method is applied to implement a Toffoli gate in bipartite and tripartite systems. In this method, we considered cases in which a group of qubits belongs to one subsystem of the network. Then, we improved its consumption resources.},
