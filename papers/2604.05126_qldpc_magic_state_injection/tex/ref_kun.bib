	pages = {518--524},
}

@misc{draganic_rolling_2021,
	title = {Rolling backwards can move you forward: on embedding problems in sparse expanders},
	shorttitle = {Rolling backwards can move you forward},
	url = {http://arxiv.org/abs/2007.08332},
	abstract = {We develop a general embedding method based on the Friedman-Pippenger tree embedding technique (1987) and its algorithmic version, essentially due to Aggarwal et al. (1996), enhanced with a roll-back idea allowing to sequentially retrace previously performed embedding steps. We use this method to obtain the following results. -We show that the size-Ramsey number of logarithmically long subdivisions of bounded degree graphs is linear in their number of vertices, settling a conjecture of Pak (2002). -We give a deterministic, polynomial time online algorithm for finding vertex-disjoint paths of prescribed length between given pairs of vertices in an expander graph. Our result answers a question of Alon and Capalbo (2007). -We show that relatively weak bounds on the spectral ratio of \$d\$-regular graphs force the existence of a topological minor of \$K\_t\$ where \$t=(1-o(1))d\$. We also exhibit a construction which shows that the theoretical maximum \$t=d+1\$ cannot be attained even if \${\textbackslash}lambda=O({\textbackslash}sqrt\{d\})\$. This answers a question of Fountoulakis, K{\textbackslash}"uhn and Osthus (2009).},
	urldate = {2023-09-05},
	publisher = {arXiv},
	author = {Draganić, Nemanja and Krivelevich, Michael and Nenadov, Rajko},
	month = mar,
	year = {2021},
	note = {arXiv:2007.08332 [math]},
	keywords = {Mathematics - Combinatorics},
}

