}

@article{dou_distributed_nodate,
	title = {Distributed {Construction} of {Near}-{Optimal} {Compact} {Routing} {Schemes} for {Planar} {Graphs}},
	abstract = {We consider the problem of computing compact routing tables for a (weighted) planar graph G := (V, E, w) in the PRAM, CONGEST, and the novel HYBRID communication model. We present algorithms with polylogarithmic work and communication that are almost optimal in all relevant parameters, i.e., computation time, table sizes, and stretch. All algorithms are heavily randomized, and all our bounds hold w.h.p. For a given parameter ϵ {\textgreater} 0, our scheme computes labels of size O˜(ϵ−1) and is computed in O˜(ϵ−3) time and O˜(n) work in the PRAM and the HYBRID model and O(ϵ−3 · HD) (Here, HD denotes the network’s hop-diameter) time in CONGEST. The stretch of the resulting routing scheme is 1 + ϵ. To achieve these results, we extend the divide-and-conquer framework of Li and Parter [STOC ’19] and combine it with state-of-the-art distributed distance approximation algorithms [STOC ’22].},
	language = {en},
	author = {Dou, Jinfeng and Götte, Thorsten and Hillebrandt, Henning and Scheideler, Christian and Werthmann, Julian},
}

