@misc{wald_gpu-friendly_2022,
	title = {{GPU}-friendly, {Parallel}, and ({Almost}-){In}-{Place} {Construction} of {Left}-{Balanced} k-d {Trees}},
	url = {http://arxiv.org/abs/2211.00120},
	doi = {10.48550/arXiv.2211.00120},
	abstract = {We present an algorithm that allows for building left-balanced and complete k-d trees over k-dimensional points in a trivially parallel and GPU friendly way. Our algorithm requires exactly one int per data point as temporary storage, and uses O(log N) iterations, each of which performs one parallel sort, and one trivially parallel CUDA per-node update kernel.},
	urldate = {2022-12-16},
	publisher = {arXiv},
	author = {Wald, Ingo},
	month = nov,
	year = {2022},
	note = {arXiv:2211.00120 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, Computer Science - Graphics},
}

@article{shevtsov_highly_2007,
	title = {Highly {Parallel} {Fast} {KD}-tree {Construction} for {Interactive} {Ray} {Tracing} of {Dynamic} {Scenes}},
	volume = {26},
	issn = {0167-7055, 1467-8659},
	url = {https://onlinelibrary.wiley.com/doi/10.1111/j.1467-8659.2007.01062.x},
	doi = {10.1111/j.1467-8659.2007.01062.x},
	abstract = {We present a highly parallel, linearly scalable technique of kd-tree construction for ray tracing of dynamic geometry. We use conventional kd-tree compatible with the high performing algorithms such as MLRTA or frustum tracing. Proposed technique offers exceptional construction speed maintaining reasonable kd-tree quality for rendering stage. The algorithm builds a kd-tree from scratch each frame, thus prior knowledge of motion/deformation or motion constraints are not required. We achieve nearly real-time performance of 7-12 FPS for models with 200K of dynamic triangles at 1024x1024 resolution with shadows and textures.},
	language = {en},
	number = {3},
	urldate = {2022-12-16},
	journal = {Computer Graphics Forum},
	author = {Shevtsov, Maxim and Soupikov, Alexei and Kapustin, Alexander},
	month = sep,
	year = {2007},
	pages = {395--404},
}

@article{wehr_parallel_2018,
	title = {Parallel kd-{Tree} {Construction} on the {GPU} with an {Adaptive} {Split} and {Sort} {Strategy}},
	volume = {46},
	issn = {1573-7640},
	url = {https://doi.org/10.1007/s10766-018-0571-0},
	doi = {10.1007/s10766-018-0571-0},
	abstract = {We introduce a parallel kd-tree construction method for 3-dimensional points on a GPU which employs a sorting algorithm that maintains high parallelism throughout construction. Typically, large arrays in the upper levels of a kd-tree do not yield high performance when computing each node in one thread. Conversely, small arrays in the lower levels of the tree do not benefit from typical parallel sorts. To address these issues, the proposed sorting approach uses a modified parallel sort on the upper levels before switching to basic parallelization on the lower levels. Our work focuses on 3D point registration and our results indicate that a speed gain by a factor of 100 can be achieved in comparison to a naive parallel algorithm for a typical scene.},
	language = {en},
	number = {6},
	urldate = {2022-12-16},
	journal = {International Journal of Parallel Programming},
	author = {Wehr, David and Radkowski, Rafael},
	month = dec,
	year = {2018},
	keywords = {3D-point registration, GPU computing, Parallel radix sort, kd-Tree construction},
	pages = {1139--1156},
}

@misc{yesantharao_parallel_2021,
	title = {Parallel {Batch}-{Dynamic} \$k\$d-{Trees}},
	url = {http://arxiv.org/abs/2112.06188},
	abstract = {\$k\$d-trees are widely used in parallel databases to support efficient neighborhood/similarity queries. Supporting parallel updates to \$k\$d-trees is therefore an important operation. In this paper, we present BDL-tree, a parallel, batch-dynamic implementation of a \$k\$d-tree that allows for efficient parallel \$k\$-NN queries over dynamically changing point sets. BDL-trees consist of a log-structured set of \$k\$d-trees which can be used to efficiently insert or delete batches of points in parallel with polylogarithmic depth. Specifically, given a BDL-tree with \$n\$ points, each batch of \$B\$ updates takes \$O(B{\textbackslash}log{\textasciicircum}2\{(n+B)\})\$ amortized work and \$O({\textbackslash}log(n+B){\textbackslash}log{\textbackslash}log\{(n+B)\})\$ depth (parallel time). We provide an optimized multicore implementation of BDL-trees. Our optimizations include parallel cache-oblivious \$k\$d-tree construction and parallel bloom filter construction. Our experiments on a 36-core machine with two-way hyper-threading using a variety of synthetic and real-world datasets show that our implementation of BDL-tree achieves a self-relative speedup of up to \$34.8{\textbackslash}times\$ (\$28.4{\textbackslash}times\$ on average) for batch insertions, up to \$35.5{\textbackslash}times\$ (\$27.2{\textbackslash}times\$ on average) for batch deletions, and up to \$46.1{\textbackslash}times\$ (\$40.0{\textbackslash}times\$ on average) for \$k\$-nearest neighbor queries. In addition, it achieves throughputs of up to 14.5 million updates/second for batch-parallel updates and 6.7 million queries/second for \$k\$-NN queries. We compare to two baseline \$k\$d-tree implementations and demonstrate that BDL-trees achieve a good tradeoff between the two baseline options for implementing batch updates.},
	urldate = {2022-12-16},
	publisher = {arXiv},
	author = {Yesantharao, Rahul and Wang, Yiqiu and Dhulipala, Laxman and Shun, Julian},
	month = dec,
	year = {2021},
	note = {arXiv:2112.06188 [cs]},
	keywords = {Computer Science - Data Structures and Algorithms, Computer Science - Databases},
}

@inproceedings{xu_quartz_2022,
	address = {New York, NY, USA},
	series = {{PLDI} 2022},
	title = {Quartz: superoptimization of {Quantum} circuits},
	isbn = {978-1-4503-9265-5},
	shorttitle = {Quartz},
	url = {https://doi.org/10.1145/3519939.3523433},
	doi = {10.1145/3519939.3523433},
	abstract = {Existing quantum compilers optimize quantum circuits by applying circuit transformations designed by experts. This approach requires significant manual effort to design and implement circuit transformations for different quantum devices, which use different gate sets, and can miss optimizations that are hard to find manually. We propose Quartz, a quantum circuit superoptimizer that automatically generates and verifies circuit transformations for arbitrary quantum gate sets. For a given gate set, Quartz generates candidate circuit transformations by systematically exploring small circuits and verifies the discovered transformations using an automated theorem prover. To optimize a quantum circuit, Quartz uses a cost-based backtracking search that applies the verified transformations to the circuit. Our evaluation on three popular gate sets shows that Quartz can effectively generate and verify transformations for different gate sets. The generated transformations cover manually designed transformations used by existing optimizers and also include new transformations. Quartz is therefore able to optimize a broad range of circuits for diverse gate sets, outperforming or matching the performance of hand-tuned circuit optimizers.},
	urldate = {2022-12-12},
	booktitle = {Proceedings of the 43rd {ACM} {SIGPLAN} {International} {Conference} on {Programming} {Language} {Design} and {Implementation}},
	publisher = {Association for Computing Machinery},
	author = {Xu, Mingkuan and Li, Zikun and Padon, Oded and Lin, Sina and Pointing, Jessica and Hirth, Auguste and Ma, Henry and Palsberg, Jens and Aiken, Alex and Acar, Umut A. and Jia, Zhihao},
	month = jun,
	year = {2022},
	keywords = {quantum computing, superoptimization},
	pages = {625--640},
}

@article{nurnberger_bivariate_1995,
	title = {Bivariate spline interpolation at grid points},
