@misc{cho_parameterized_2022,
	title = {Parameterized {Algorithm} for the {Disjoint} {Path} {Problem} on {Planar} {Graphs}: {Exponential} in \$k{\textasciicircum}2\$ and {Linear} in \$n\$},
	shorttitle = {Parameterized {Algorithm} for the {Disjoint} {Path} {Problem} on {Planar} {Graphs}},
