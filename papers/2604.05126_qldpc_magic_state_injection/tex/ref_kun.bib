@article{campbell_random_2019,
	title = {A random compiler for fast {Hamiltonian} simulation},
	volume = {123},
	issn = {0031-9007, 1079-7114},
	url = {http://arxiv.org/abs/1811.08017},
	doi = {10.1103/PhysRevLett.123.070503},
	abstract = {The dynamics of a quantum system can be simulated using a quantum computer by breaking down the unitary into a quantum circuit of one and two qubit gates. The most established methods are the Trotter-Suzuki decompositions, for which rigorous bounds on the circuit size depend on the number of terms \$L\$ in the system Hamiltonian and the size of the largest term in the Hamiltonian \${\textbackslash}Lambda\$. Consequently, Trotter-Suzuki is only practical for sparse Hamiltonians. Trotter-Suzuki is a deterministic compiler but it was recently shown that randomised compiling offers lower overheads. Here we present and analyse a randomised compiler for Hamiltonian simulation where gate probabilities are proportional to the strength of a corresponding term in the Hamiltonian. This approach requires a circuit size independent of \$L\$ and \${\textbackslash}Lambda\$, but instead depending on \${\textbackslash}lambda\$ the absolute sum of Hamiltonian strengths (the \${\textbackslash}ell\_1\$ norm). Therefore, it is especially suited to electronic structure Hamiltonians relevant to quantum chemistry. Considering propane, carbon dioxide and ethane, we observe speed-ups compared to standard Trotter-Suzuki of between \$306{\textbackslash}times\$ and \$1591{\textbackslash}times\$ for physically significant simulation times at precision \$10{\textasciicircum}\{-3\}\$. Performing phase estimation at chemical accuracy, we report that the savings are similar.},
	number = {7},
	urldate = {2024-02-27},
	journal = {Physical Review Letters},
	author = {Campbell, Earl},
	month = aug,
	year = {2019},
	note = {arXiv:1811.08017 [quant-ph]},
	keywords = {Quantum Physics},
	pages = {070503},
}

@article{guimond_unidirectional_2020,
