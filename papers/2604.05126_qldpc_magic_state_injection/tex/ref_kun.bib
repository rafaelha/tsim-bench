@misc{gupta_fault-tolerance_2025,
	title = {Fault-tolerance of [[6, 1, 3]] non-{CSS} code family generated using measurements on graph states},
	url = {http://arxiv.org/abs/2501.12072},
	doi = {10.48550/arXiv.2501.12072},
	abstract = {We construct and analyze the fault tolerance of \$[[6,1,3]]\$ non-CSS quantum error correcting code under the anisotropic and depolarizing noise models. This rate-optimized code achieves fault-tolerance using a single ancilla qubit for syndrome measurement under anisotropic noise conditions. This method was called fault-tolerance using bare ancilla by Brown {\textbackslash}emph\{et al.\} We give explicit construction of the code using measurements on non-planar graph states. We also argue that using our approach, we can construct a family of such fault-tolerant codes. This method fills a notable gap in constructing fault-tolerant non-CSS code families.},
