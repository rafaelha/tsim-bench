	abstract = {In this paper, we study the {\textbackslash}textsf\{Planar Disjoint Paths\} problem: Given an undirected planar graph \$G\$ with \$n\$ vertices and a set \$T\$ of \$k\$ pairs \$(s\_i,t\_i)\_\{i=1\}{\textasciicircum}k\$ of vertices, the goal is to find a set \${\textbackslash}mathcal P\$ of \$k\$ pairwise vertex-disjoint paths connecting \$s\_i\$ and \$t\_i\$ for all indices \$i{\textbackslash}in{\textbackslash}\{1,{\textbackslash}ldots,k{\textbackslash}\}\$. We present a \$2{\textasciicircum}\{O(k{\textasciicircum}2)\}n\$-time algorithm for the {\textbackslash}textsf\{Planar Disjoint Paths\} problem. This improves the two previously best-known algorithms: \$2{\textasciicircum}\{2{\textasciicircum}\{O(k)\}\}n\$-time algorithm [Discrete Applied Mathematics 1995] and \$2{\textasciicircum}\{O(k{\textasciicircum}2)\}n{\textasciicircum}6\$-time algorithm [STOC 2020].},
	urldate = {2023-09-04},
