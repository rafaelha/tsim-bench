@article{devulapalli_quantum_2024,
	title = {Quantum {Routing} with {Teleportation}},
	volume = {6},
	issn = {2643-1564},
	url = {http://arxiv.org/abs/2204.04185},
	doi = {10.1103/PhysRevResearch.6.033313},
	abstract = {We study the problem of implementing arbitrary permutations of qubits under interaction constraints in quantum systems that allow for arbitrarily fast local operations and classical communication (LOCC). In particular, we show examples of speedups over swap-based and more general unitary routing methods by distributing entanglement and using LOCC to perform quantum teleportation. We further describe an example of an interaction graph for which teleportation gives a logarithmic speedup in the worst-case routing time over swap-based routing. We also study limits on the speedup afforded by quantum teleportation - showing an \$O({\textbackslash}sqrt\{N {\textbackslash}log N\})\$ upper bound on the separation in routing time for any interaction graph - and give tighter bounds for some common classes of graphs.},
	number = {3},
	urldate = {2024-09-26},
	journal = {Physical Review Research},
	author = {Devulapalli, Dhruv and Schoute, Eddie and Bapat, Aniruddha and Childs, Andrew M. and Gorshkov, Alexey V.},
	month = sep,
	year = {2024},
	note = {arXiv:2204.04185 [quant-ph]},
