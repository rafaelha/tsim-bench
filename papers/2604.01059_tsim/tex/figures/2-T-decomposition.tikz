		\node [style=none] (4) at (0.5, 0) {$=$};
		\node [style=Z phase dot] (5) at (1.75, -0.012) {$\frac\pi2$};
		\node [style=none] (6) at (2.775, 0.487) {};
		\node [style=none] (8) at (2.8, -0.513) {};
		\node [style=none] (9) at (4, 0) {$+\ e^{i\frac\pi4}$};
		\node [style=X phase dot] (15) at (5.75, -0.01200000000000001) {$\pi$};
