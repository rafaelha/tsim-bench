@misc{criger_concatenated_toric_code_2016,
	title = {Noise {Thresholds} for the [[4, 2, 2]]-concatenated {Toric} {Code}},
	url = {http://arxiv.org/abs/1604.04062},
	doi = {10.48550/arXiv.1604.04062},
	abstract = {We analyze the properties of a 2D topological code derived by concatenating the [[4, 2, 2]] code with the toric/surface code, or alternatively by removing check operators from the 2D square-octagon or 4.8.8 color code. We show that the resulting code has a circuit-based noise threshold of \${\textbackslash}sim 0.41{\textbackslash}\%\$ (compared to \${\textbackslash}sim 0.6{\textbackslash}\%\$ for the toric code in a similar scenario), which is higher than any known 2D color code. We believe that the construction may be of interest for hardware in which one wants to use both long-range two-qubit gates as well as short-range gates between small clusters of qubits.},
	urldate = {2025-01-08},
	publisher = {arXiv},
	author = {Criger, Ben and Terhal, Barbara},
	month = {aug},
	year = {2016},
	note = {arXiv:1604.04062},
	keywords = {Quantum Physics},
}

