\bibitem [{Note2()}]{Note2}%
  \BibitemOpen
  \bibinfo {note} {Assuming ${d_X}\geq {d_Z}$, there exist $N_\protect \mathrm
  {diag} \mathrel {\mathop :}\mathrel {\mkern -1.2mu}=\protect \binom {l}{r}$
  shortest paths for diagonal error strings, where $l \mathrel {\mathop
  :}\mathrel {\mkern -1.2mu}={d_X}/2 - 1$ and $r \mathrel {\mathop :}\mathrel
  {\mkern -1.2mu}=({d_X}- {d_Z}) / 2$. For vertical error strings (causing
  $\protect \overline {X}_1$ or $\protect \overline {X}_2$ errors), there are
  approximately $N_\protect \mathrm {v} \mathrel {\mathop :}\mathrel {\mkern
  -1.2mu}={d_Z}\cdot 2^{{d_X}/2-1}$ shortest paths. Comparing these two values,
  $N_\protect \mathrm {diag} / N_\protect \mathrm {v} < 0.1$ for ${d_X}\geq 8$
  or ${d_Z}\geq 6$, and $N_\protect \mathrm {diag} / N_\protect \mathrm {v} <
  0.05$ for ${d_X}\geq 14$ or ${d_Z}\geq 8$. In general, we obtain $N_\protect
  \mathrm {diag}/N_\protect \mathrm {v} < 2/[{d_Z}\protect \sqrt {\pi ({d_X}-
  2)}]$ from the inequality $\protect \binom {l}{r} \leq \protect \binom
  {l}{l/2} < \protect \sqrt {2/(\pi l)} 2^l$. Hence, although diagonal and
  vertical error strings have the same minimum weight, they differ
  significantly in their frequency of occurrence, assuming that circuit-level
  noise acts at similar levels in both directions.}\BibitemShut {Stop}%
