\bibitem [{Note1()}]{Note1}%
  \BibitemOpen
  \bibinfo {note} {Note that these thresholds are \protect \textit {scaling}
  thresholds, not \protect \textit {crossing} thresholds. That is, they
  correspond to the parameter $p_\protect \mathrm {th}$ in the sub-threshold
  ansatz given by Eq.~\protect \eqref {eq:ansatz}, rather than the intersection
  points of curves for different code distances. These two thresholds generally
  differ, as the ansatz breaks down near threshold. Although the crossing
  threshold is commonly used as a standard definition in the literature, the
  scaling threshold is more relevant in the low-error regime as we consider in
  our analysis.}\BibitemShut {Stop}%
